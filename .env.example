# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Chave Service Role do Supabase (ou SUPABASE_ANON_KEY com RLS desativado)
SUPABASE_SERVICE_ROLE_KEY=

# SESSION_SECRET: Chave fixa para assinar sessões de gestão (recomendado na Vercel)
SESSION_SECRET=

# ADMIN_ACCESS_EMAIL: Email secreto no ícone Perfil para acesso direto à Gestão
ADMIN_ACCESS_EMAIL=Dozaelizandro@gmail.com

# ADMIN_PASSCODE: Palavra-passe de acesso ao painel de gestão (opcional)
ADMIN_PASSCODE=

# ORDER_NOTIFICATION_EMAIL: Email que recebe notificações de novos pedidos em tempo real
ORDER_NOTIFICATION_EMAIL=pintozacarias806@gmail.com

# SMTP (ex: Gmail com Senha de Aplicação para envio real de emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# RESEND_API_KEY: Alternativa ao SMTP via API Resend (opcional)
RESEND_API_KEY=
RESEND_FROM=
